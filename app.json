{
  "expo": {
    "name": "Thrive",
    "slug": "thrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios-dark.png",
    "scheme": "thrive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      }
    },
    "android": {
      "icon": "./assets/images/ios-dark.png",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F4",
        "foregroundImage": "./assets/images/ios-dark.png",
        "backgroundImage": "./assets/images/ios-dark.png",
        "monochromeImage": "./assets/images/ios-dark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/ios-dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F4",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Thrive uses your photos as quote backgrounds."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Thrive saves quote images to your photos.",
          "savePhotosPermission": "Thrive saves quote images to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
